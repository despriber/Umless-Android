<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
        <!-- Umless: 识别模型（约 230MB，可重新下载）与诊断日志不备份；否则超出云备份 25MB 配额，整个应用的备份都会失败 -->
        <exclude
            domain="file"
            path="umless/models" />
        <exclude
            domain="file"
            path="umless/logs" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
        <!-- Umless: 识别模型（约 230MB，可重新下载）与诊断日志不备份；否则超出云备份 25MB 配额，整个应用的备份都会失败 -->
        <exclude
            domain="file"
            path="umless/models" />
        <exclude
            domain="file"
            path="umless/logs" />
    </device-transfer>
</data-extraction-rules>